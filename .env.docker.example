# CheckerAI Docker Environment Variables
# Copy this file to .env (in the same directory as docker-compose.yml) and fill in your keys.

# ── Required API Keys ──────────────────────────────────────────────────────────
# OpenAI key (used for OCR and some grading steps)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Anthropic key (used for Claude-based answer alignment and grading — REQUIRED)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# ── Optional: Multi-Profile Support (Profile 2) ──────────────────────────────
# If using the "Profile 2" option on the frontend, add these:
ANTHROPIC_API_KEY_PROFILE_2=sk-ant-YOUR_SECOND_ANTHROPIC_KEY_HERE
OPENAI_API_KEY_PROFILE_2=sk-proj-YOUR_SECOND_OPENAI_KEY_HERE

# ── Optional: JWT Auth ─────────────────────────────────────────────────────────
# Used for secure API authentication. Can be any long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ── Optional: Email (MentorAI) ─────────────────────────────────────────────────
# Only needed if MentorAI email features are used
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=your-email@gmail.com
# FROM_NAME=MentorAI
